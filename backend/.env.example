# Optional: URL direct Neon, copiat complet din dashboard, inclusiv parametrii TLS.
# DATABASE_URL are prioritate fata de campurile locale de mai jos.
# Goleste DATABASE_URL pentru a reveni la PostgreSQL local.
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=10

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=welltrack
DATABASE_USER=welltrack_app
DATABASE_PASSWORD=replace_with_your_local_password

APP_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
SESSION_TTL_DAYS=7
SESSION_COOKIE_SECURE=false
VERIFICATION_TTL_MINUTES=60
VERIFICATION_RESEND_SECONDS=60
AUTH_REQUESTS_PER_MINUTE=10

# local: fisiere private in backend/.local/emails; resend/brevo: trimitere reala
EMAIL_DELIVERY=local
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=WellTrack

# Brevo: EMAIL_DELIVERY=brevo si EMAIL_FROM=adresa verificata, fara nume sau < >.
# BREVO_API_KEY necesita permisiunea Transactional email: All.

# Resend fara domeniu verificat: EMAIL_FROM="WellTrack <onboarding@resend.dev>"
# In acest mod poti trimite teste doar catre emailul asociat contului Resend.

# OAuth Google: Web application; callback inregistrat exact ca mai jos.
# Pastreaza acelasi hostname in FRONTEND_URL, browser si GOOGLE_REDIRECT_URI.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Cheie locala aleatorie de minimum 32 de caractere pentru cookie-ul OAuth temporar.
OAUTH_SESSION_SECRET=
